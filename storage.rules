rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Anyone can read blog cover images
    match /blog_covers/{allPaths=**} {
      allow read: if true;
      // Only authenticated users can upload images, max 5MB, image content-type only
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Default fallback for any other files in storage
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
